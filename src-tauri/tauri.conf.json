{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "not. studio",
  "version": "0.1.3",
  "identifier": "studio.not.journal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "not. — личный дневник",
        "width": 1280,
        "height": 840,
        "minWidth": 640,
        "minHeight": 540,
        "backgroundColor": "#17171d",
        "theme": "Dark",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Личный зашифрованный дневник",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Russian"
        ],
        "installMode": "currentUser"
      }
    }
  }
}
